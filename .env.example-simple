# Web3Auth (MetaMask Embedded Wallets) setup for social or passwordless login.
# Create a project, configure allowed origins and authentication connections:
# https://docs.metamask.io/embedded-wallets/dashboard/authentication/
# Network: mainnet or testnet. Match the client ID and verifier settings to it.
NEXT_PUBLIC_WEB3AUTH_NETWORK=
NEXT_PUBLIC_WEB3AUTH_CLIENTID=
NEXT_PUBLIC_WEB3AUTH_COREKIT_ENABLED=

# Google OAuth client ID from Google Cloud; verifier names from your Web3Auth setup.
# https://developers.google.com/workspace/guides/create-credentials
NEXT_PUBLIC_WEB3AUTH_GOOGLE_CLIENTID=
NEXT_PUBLIC_WEB3AUTH_GOOGLE_VERIFIER=
NEXT_PUBLIC_WEB3AUTH_GOOGLE_SUBVERIFIER=

# Facebook app ID and matching Web3Auth verifier for Facebook login.
# https://docs.metamask.io/embedded-wallets/authentication/social-logins/facebook/
NEXT_PUBLIC_WEB3AUTH_FACEBOOK_CLIENTID=
NEXT_PUBLIC_WEB3AUTH_FACEBOOK_VERIFIER=

# Auth0 client ID and domain, Web3Auth verifier, and hCaptcha public sitekey.
# https://auth0.com/docs/quickstart/spa
# https://docs.hcaptcha.com/
NEXT_PUBLIC_WEB3AUTH_AUTH0_CAPTCHA_KEY=
NEXT_PUBLIC_WEB3AUTH_AUTH0_CLIENTID=
NEXT_PUBLIC_WEB3AUTH_AUTH0_VERIFIER=
NEXT_PUBLIC_WEB3AUTH_AUTH0_DOMAIN=

# RPC endpoints are chain-specific. Replace YOUR_ALCHEMY_API_KEY and uncomment the Alchemy lines you need.
# NEXT_PUBLIC_ values are exposed to the browser; restrict provider keys accordingly.
# Create an Alchemy app and obtain an API key and chain endpoint URLs:
# https://www.alchemy.com/docs/create-an-api-key
# NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
NEXT_PUBLIC_FUSE_RPC_URL=https://rpc.fuse.io
# NEXT_PUBLIC_CELO_RPC_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
# Holesky is in the local configuration but is not currently read by the wallet configuration.
# NEXT_PUBLIC_HOLESKY_RPC_URL=https://eth-holesky.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_HOODI_RPC_URL=https://eth-hoodi.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_BNB_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
NEXT_PUBLIC_XDC_RPC_URL=https://xdc.public-rpc.com
# Default invite chain: 42220 = Celo (default), 50 = XDC.
NEXT_PUBLIC_PRIMARY_INVITE_CHAIN_ID=50

# XRP uses WebSocket endpoints; public mainnet/testnet defaults are used when unset.
NEXT_PUBLIC_XRP_RPC_URL=wss://xrplcluster.com/
NEXT_PUBLIC_XRP_TESTNET_RPC_URL=wss://s.altnet.rippletest.net:51233/

# Set to true to include testnet tokens; other values disable them.
NEXT_PUBLIC_INCLUDE_TESTNET_TOKENS=true

# GoodDollar environment: development, or production. Selects contract deployments and GoodID/GoodServer URLs.
# Deployment names use <environment>-celo or <environment>-xdc; Fuse development uses fuse.

# Critical Note:  When set to production this is really wired to the production contracts onchain.
# Be mindful when setting it to production and better not whitelist.
# With web3auth set to testnet your wallet you login too will differ from when you visit goodwallet.xyz live
# But the face-verification process is separate and it will be registered and the logged wallet will be whitelisted/G$ verified
# That is not a reversable process and you would be stuck for 6 months.
# Recommended: Test mostly against development contracts where possible
NEXT_PUBLIC_GOODDOLLAR_CONTRACTS=development

# Set to true to enable on-chain GoodDollar reserve pricing; other values disable it.
NEXT_PUBLIC_USE_RESERVE_PRICE=true

# Login switches: only the exact value true enables each option. Configure authentication separately.
NEXT_PUBLIC_LOGIN_PWLESS_ENABLED=true
# This eToro switch is in the local configuration but has no current code reference.
NEXT_PUBLIC_LOGIN_ETORO_ENABLED=true
NEXT_PUBLIC_LOGIN_GOOGLE_ENABLED=true
# Test login is for development/testing. It also uses NEXT_PUBLIC_TEST_LOGIN_MASTER_SEED,
# NEXT_PUBLIC_TEST_LOGIN_USER_NAME, and NEXT_PUBLIC_TEST_LOGIN_PROFILE_IMAGE.
NEXT_PUBLIC_TEST_LOGIN_ENABLED=true

# Present in the local configuration; no current code reference was found.
NEXT_PUBLIC_MPC_APP_DOMAIN=https://sign.goodwallet.dev

# XDC transaction history uses Etherscan API keys (not wallet private keys).
# Create an account and key: https://docs.etherscan.io/set-up-your-api-key
# Uncomment and set these in .env.development to test XDC history. The same key
# can be used for all three; check Etherscan plan limits for XDC and these APIs.
# LEDGER_XDC_KEY1=YOUR_ETHERSCAN_API_KEY # token transfers
# LEDGER_XDC_KEY2=YOUR_ETHERSCAN_API_KEY # normal transactions
# LEDGER_XDC_KEY3=YOUR_ETHERSCAN_API_KEY # internal transactions

# Server-side Alchemy key used for supported chain transaction history.
# Create an Alchemy app and copy its API key for server-side transaction history:
# https://www.alchemy.com/docs/create-an-api-key
# Keep this server key private; uncomment and set it in .env.development.
# ALCHEMY_SERVER_API_KEY=YOUR_ALCHEMY_API_KEY

# Tatum keys for mainnet and testnet chain API requests, respectively.
# For Bitcoin, Dogecoin, and XRP chain APIs, get Tatum API keys from the dashboard:
# https://docs.tatum.io/docs/getting-started
# Keep keys private; configure the appropriate mainnet and testnet keys locally.
# TATUM_MAINNET_API_KEY=
# TATUM_TESTNET_API_KEY=

# Feed configuration: URL and context select the news feed; tag is optional.
NEXT_PUBLIC_GOODDOLLAR_FEED_TAG="publishWalletV2"
NEXT_PUBLIC_GOODDOLLAR_FEED_CTX="kjzl6cwe1jw147bfd2hn7f3j2sdsq6708xnb3a217iz1m18a35v25kgxna3s0os"
NEXT_PUBLIC_GOODDOLLAR_FEED_URL="https://feed-dev.gooddollar.org/api/ceramic-feed/posts/"

# Database URL supports postgres:// or postgresql:// (Neon HTTP), or pglite://<local-path>.
POSTGRES_TOKENS_DATABASE_URL="pglite://./data/local.db"

